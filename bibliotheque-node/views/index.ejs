<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mini Bibliothèque</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>Mini Bibliothèque</h1><p>Gestion simple des livres et emprunts</p></header><main>
<% if (message) { %><div class="notice success"><%= message %></div><% } %><section class="stats"><% [['Livres',stats.livres],['Exemplaires',stats.exemplaires],['Emprunts en cours',stats.emprunts]].forEach(x=>{ %><div><strong><%= x[1] %></strong><span><%= x[0] %></span></div><% }) %></section>
<section class="grid"><form method="post" action="/books"><h2>Ajouter un livre</h2><input name="titre" placeholder="Titre" required><input name="auteur" placeholder="Auteur" required><input name="categorie" placeholder="Catégorie"><input name="quantite" type="number" min="1" placeholder="Quantité" required><button>Ajouter</button></form><form method="post" action="/borrowers"><h2>Enregistrer un emprunteur</h2><input name="nom" placeholder="Nom" required><input name="telephone" placeholder="Téléphone" required><button>Enregistrer</button></form><form method="post" action="/loans"><h2>Nouvel emprunt</h2><select name="livre_id" required><option value="">Livre</option><% books.filter(b=>b.disponibles>0).forEach(b=>{ %><option value="<%= b.id %>"><%= b.titre %> (<%= b.disponibles %>)</option><% }) %></select><select name="emprunteur_id" required><option value="">Emprunteur</option><% borrowers.forEach(b=>{ %><option value="<%= b.id %>"><%= b.nom %></option><% }) %></select><button>Emprunter</button></form></section>
<section><form class="search"><input name="q" value="<%= query %>" placeholder="Rechercher un titre ou auteur"><button>Rechercher</button></form><h2>Livres</h2><div class="table-wrap"><table><tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th>Disponibles</th><th>Actions</th></tr><% books.forEach(b=>{ %><tr><td><%= b.titre %></td><td><%= b.auteur %></td><td><%= b.categorie || '-' %></td><td><%= b.disponibles %>/<%= b.quantite %></td><td><form method="post" action="/books/<%= b.id %>/edit" class="inline"><input name="titre" value="<%= b.titre %>" required><input name="auteur" value="<%= b.auteur %>" required><input name="categorie" value="<%= b.categorie || '' %>"><input name="quantite" type="number" min="1" value="<%= b.quantite %>" required><button>Modifier</button></form><form method="post" action="/books/<%= b.id %>/delete" class="inline"><button>Supprimer</button></form></td></tr><% }) %></table></div></section><section><h2>Emprunts</h2><div class="table-wrap"><table><tr><th>Livre</th><th>Emprunteur</th><th>Statut</th><th>Action</th></tr><% loans.forEach(l=>{ %><tr><td><%= l.titre %></td><td><%= l.emprunteur %></td><td><%= l.statut %></td><td><% if(l.statut==='en_cours'){ %><form method="post" action="/loans/<%= l.id %>/return"><button>Retourner</button></form><% } else { %><%= l.date_retour %><% } %></td></tr><% }) %></table></div></section></main></body></html>
